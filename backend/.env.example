# Copy this file to `.env` (same folder) and fill in ONE of the two options.
# `.env` is gitignored, so your key never gets committed.

# ---------------------------------------------------------------------------
# Option 1 (recommended) — Gemini Developer API
# Get a free key at https://aistudio.google.com/apikey
# No gcloud install, no GCP project, no admin rights needed.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=paste-your-key-here

# ---------------------------------------------------------------------------
# Optional — which model to use.
# Defaults to gemini-flash-latest, which tracks the current fast model. Older
# pinned names such as gemini-2.5-flash are no longer served to new API keys and
# fail with a 404, so only pin a version if you need byte-stable behaviour.
# ---------------------------------------------------------------------------
# GEMINI_MODEL=gemini-flash-latest

# Model for text and search-query scans, which sit in front of a page load and so
# need to be quick. flash-lite measured ~0.9s against ~4-7s for full flash here,
# with the same verdicts.
# GEMINI_FAST_MODEL=gemini-flash-lite-latest

# ---------------------------------------------------------------------------
# Option 2 — Vertex AI
# Needs the Vertex AI API enabled on the project, plus:
#     gcloud auth application-default login
# Leave GEMINI_API_KEY blank/removed if you use this instead.
# ---------------------------------------------------------------------------
# GCP_PROJECT_ID=your-gcp-project-id
